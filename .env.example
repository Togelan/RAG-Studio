# RAG-Studio environment template. Copy to .env for local customization.
# Keep credential, token, and passphrase assignments empty; the application
# uses local-only defaults when optional overrides are left unset.

# LLM provider defaults (model choices are non-secret).
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3
LLM_CLASSIFIER_MODEL=gpt-4o-mini
LLM_REQUEST_TIMEOUT=60

# Local embedded Qdrant is the safe default. Leave remote settings empty.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=

# Optional LangSmith observability. The key remains empty by default.
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-studio
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Application-managed paths default below rag-data when these are unset.
RAG_STUDIO_DATA_ROOT=
RAG_STUDIO_SETTINGS_PATH=
RAG_STUDIO_LOGS_PATH=
FASTEMBED_CACHE_PATH=
FLASHRANK_CACHE_PATH=

# Security-sensitive values are intentionally empty.
RAG_STUDIO_PASSPHRASE=
RAG_STUDIO_AUTH_TOKEN=

# Safe local development defaults.
RAG_STUDIO_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://[::1]:8000
LOG_LEVEL=INFO
RAG_STUDIO_CHAT_RPM_LIMIT=30
RAG_STUDIO_UPLOAD_RPM_LIMIT=10
RAG_STUDIO_GENERAL_RPM_LIMIT=60
