# RAG-Studio environment template. Copy to .env for local customization.
# Keep credential, token, and passphrase assignments empty; the application
# uses local-only defaults when optional overrides are left unset.

# LLM provider defaults (model choices are non-secret).
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3
LLM_CLASSIFIER_MODEL=gpt-4o-mini
LLM_REQUEST_TIMEOUT=60

# Local embedded Qdrant is the safe default. Leave remote settings empty.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=

# Optional LangSmith observability. The key remains empty by default.
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-studio
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Application-managed paths default below rag-data when these are unset.
RAG_STUDIO_DATA_ROOT=
RAG_STUDIO_SETTINGS_PATH=
RAG_STUDIO_LOGS_PATH=
FASTEMBED_CACHE_PATH=
FLASHRANK_CACHE_PATH=

# Runtime/UI values form a closed pair: local+legacy or saas+react.
# Mixed pairs fail startup before any route is mounted.
RAG_STUDIO_UI_MODE=legacy

# Stage 3 runtime selector. The `stage3` profile requires the empty values below
# to be supplied by a separate operator-owned env file. Never commit that file.
RAG_STUDIO_RUNTIME_MODE=local
RAG_STUDIO_SUPABASE_URL=http://stage3-auth:9999
RAG_STUDIO_SUPABASE_JWT_ISSUER=http://127.0.0.1:8013/auth/v1
RAG_STUDIO_SUPABASE_JWT_AUDIENCE=authenticated
RAG_STUDIO_SUPABASE_DATABASE_URL=
RAG_STUDIO_SESSION_SIGNING_KEY=
# Comma-separated key-id:base64url-32-byte-key entries. The first entry is the
# current write key; remaining entries are previous read-only keys. Key ids
# cannot contain commas. This mandatory value is intentionally empty here.
RAG_STUDIO_SESSION_ENCRYPTION_KEYS=
# Keep Secure host-prefixed cookies outside the explicit loopback HTTP demo.
RAG_STUDIO_COOKIE_SECURE=true
STAGE3_POSTGRES_PASSWORD=
STAGE3_GOTRUE_JWT_SECRET=
STAGE3_JWT_SECRET=
STAGE3_SITE_URL=http://127.0.0.1:8013
STAGE3_SAAS_APP_URL=http://127.0.0.1:8013/saas
RAG_STUDIO_SAAS_PORT=8013
STAGE3_MAILPIT_HTTP_PORT=8025
# Development-only override; rejected unless STAGE3_SITE_URL is HTTP loopback.
STAGE3_COOKIE_SECURE=false

# STAGE3_SITE_URL is also the trusted browser-origin allowlist. Use an origin
# only (scheme, host, optional port); do not include a path.

# Security-sensitive values are intentionally empty.
RAG_STUDIO_PASSPHRASE=
RAG_STUDIO_AUTH_TOKEN=

# Safe local development defaults.
RAG_STUDIO_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://[::1]:8000
LOG_LEVEL=INFO
RAG_STUDIO_CHAT_RPM_LIMIT=30
RAG_STUDIO_UPLOAD_RPM_LIMIT=10
RAG_STUDIO_GENERAL_RPM_LIMIT=60
