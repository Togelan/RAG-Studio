{
  "name": "rag-studio-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "test": "vitest --passWithNoTests",
    "build": "tsc -b && vite build",
    "test:e2e": "npm run build && playwright test --pass-with-no-tests",
    "test:a11y": "npm run build && playwright test --grep @a11y --pass-with-no-tests",
    "test:perf": "npm run build && playwright test --grep @perf --pass-with-no-tests",
    "doctor": "react-doctor",
    "audit:prod": "node scripts/audit-production.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ky": "2.0.2",
    "lucide-react": "1.31.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.13.0",
    "chrome-launcher": "1.2.1",
    "jsdom": "30.0.1",
    "lighthouse": "13.4.1",
    "msw": "2.15.0",
    "playwright-lighthouse": "4.0.0",
    "react-doctor": "0.9.12",
    "react-grab": "0.1.50",
    "react-scan": "0.5.7",
    "shadcn": "4.18.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-react-scan": "1.0.1",
    "vitest": "4.1.10"
  }
}
